---
// BUILDER NOTE: this form posts via Netlify Forms (zero-backend, free tier).
// If hosting on Cloudflare Pages instead, swap the `data-netlify` / hidden
// form-name field for a Cloudflare Pages Function, or point `action` at a
// service like Formspree. Either way, keep the honeypot field for spam.
import { SITE } from "../config";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={["bg-white rounded-[22px] shadow-soft border border-brand-200 p-8", compact ? "max-w-md" : "max-w-lg"]}>
  <h2 class="text-2xl font-serif font-semibold text-brand-900 mb-1">Request a Free Quote</h2>
  <p class="text-sm text-stone-500 mb-5">Same-day response. No obligation.</p>
  <form
    name="quote-request"
    method="POST"
    data-netlify="true"
    netlify-honeypot="company"
    class="space-y-3"
  >
    <input type="hidden" name="form-name" value="quote-request" />
    <div class="hidden">
      <label>Don't fill this out: <input name="company" /></label>
    </div>

    <div>
      <label for="name" class="sr-only">Name</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        placeholder="Your name"
        class="w-full rounded-xl border-[1.5px] border-brand-200 px-4 py-3.5 text-brand-900 bg-brand-50 placeholder:text-stone-400 focus:outline-none focus:border-brand-600 focus:bg-white transition-colors"
      />
    </div>
    <div>
      <label for="phone" class="sr-only">Phone</label>
      <input
        id="phone"
        name="phone"
        type="tel"
        required
        placeholder="Phone number"
        class="w-full rounded-xl border-[1.5px] border-brand-200 px-4 py-3.5 text-brand-900 bg-brand-50 placeholder:text-stone-400 focus:outline-none focus:border-brand-600 focus:bg-white transition-colors"
      />
    </div>
    <div>
      <label for="hair-type" class="sr-only">Hair type / treatment interest</label>
      <select
        id="hair-type"
        name="treatment-interest"
        class="w-full rounded-xl border-[1.5px] border-brand-200 px-4 py-3.5 text-brand-900 bg-brand-50 placeholder:text-stone-400 focus:outline-none focus:border-brand-600 focus:bg-white transition-colors"
      >
        <option value="">Not sure yet</option>
        <option value="brazilian-blowout">Brazilian Blowout</option>
        <option value="traditional-keratin">Traditional Keratin Smoothing</option>
        <option value="express-keratin">Express Keratin</option>
        <option value="formaldehyde-free">Formaldehyde-Free / Cysteine</option>
        <option value="nanoplasty">Nanoplasty</option>
      </select>
    </div>
    <button
      type="submit"
      class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold rounded-full px-4 py-3.5 mt-1 shadow-soft transition-colors"
    >
      Get My Free Quote
    </button>
    <p class="text-xs text-stone-400 text-center">
      Or call now: <a href={`tel:${SITE.phone}`} class="text-brand-600 font-medium">{SITE.phoneDisplay}</a>
    </p>
  </form>
</div>
