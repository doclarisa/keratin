---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { SITE } from "../config";
import heroPhoto from "../assets/images/keratin-hero.jpg";

const title = "Keratin Treatment Elmwood Park, IL | Smooth, Frizz-Free Hair";
const description =
  "Professional keratin treatments in Elmwood Park, IL — smooth away frizz for months. Brazilian blowout, formaldehyde-free & express options. Free quote.";

// BUILDER NOTE: while SITE.hasPhysicalLocation is false (organic-only /
// lead-referral mode, no real partner salon yet), we must not emit
// LocalBusiness/HairSalon/PostalAddress schema — there is no verifiable
// location. A Service schema describes the referral offering honestly
// instead. Once a real salon is attached, flip the flag and fill in
// SITE.address; this switches back to HairSalon/PostalAddress with no code
// changes needed here.
const businessSchema = SITE.hasPhysicalLocation
  ? {
      "@context": "https://schema.org",
      "@type": "HairSalon",
      name: SITE.businessName,
      image: new URL("/images/keratin-treatment-elmwood-park.svg", SITE.siteUrl).toString(),
      url: SITE.siteUrl,
      telephone: SITE.phone,
      address: {
        "@type": "PostalAddress",
        streetAddress: SITE.address,
        addressLocality: SITE.city,
        addressRegion: SITE.state,
        postalCode: SITE.zip,
        addressCountry: "US",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: SITE.geo.lat,
        longitude: SITE.geo.lng,
      },
      areaServed: SITE.areaServed,
      priceRange: SITE.priceRange,
      openingHoursSpecification: SITE.hours.map((h) => ({
        "@type": "OpeningHoursSpecification",
        dayOfWeek: h.days,
        opens: h.opens,
        closes: h.closes,
      })),
      // BUILDER NOTE: omit aggregateRating entirely unless you have real,
      // verifiable aggregated reviews. A fabricated rating is a penalty risk.
    }
  : {
      "@context": "https://schema.org",
      "@type": "Service",
      serviceType: SITE.service,
      name: `${SITE.service} Referral Service`,
      description:
        "Connects clients in the Elmwood Park, IL area with local keratin treatment specialists.",
      provider: {
        "@type": "Organization",
        name: SITE.businessName,
        url: SITE.siteUrl,
        telephone: SITE.phone,
      },
      areaServed: SITE.areaServed,
    };

const faqs = [
  {
    q: "How long does a keratin treatment take?",
    a: "Most treatments take 1.5 to 3 hours depending on your hair length, thickness, and the type of treatment. Express versions are quicker.",
  },
  {
    q: "Can I wash my hair after a keratin treatment?",
    a: "It depends on the type. After a Brazilian blowout you can wash the same day. After a traditional keratin treatment, you'll typically wait 2–3 days before washing to let it fully set.",
  },
  {
    q: "Is there a formaldehyde-free keratin treatment?",
    a: "Yes. Cysteine-based treatments and nanoplasty are formaldehyde-free smoothing options. Results are slightly more subtle and shorter-lasting, but many clients prefer them.",
  },
  {
    q: "What's the difference between keratin and a Brazilian blowout?",
    a: "A Brazilian blowout has no downtime and keeps more volume; a traditional keratin treatment lasts longer and smooths more intensely but needs a short no-wash period.",
  },
  {
    q: "Hair botox vs keratin — what's the difference?",
    a: "Hair botox is a deep conditioning and repair treatment for damaged hair; keratin is a smoothing treatment for frizz and manageability. They solve different problems.",
  },
  {
    q: "Is keratin treatment good for hair loss?",
    a: "Keratin doesn't treat hair loss, but by reducing breakage from heat styling and brushing, it can make thinning hair look fuller and healthier.",
  },
  {
    q: "How much does a keratin treatment cost in Elmwood Park?",
    a: "Prices vary by hair length and treatment type. Request a quote for an exact price.",
  },
  {
    q: "How long will my keratin treatment last?",
    a: "Typically 2–5 months. Using a sulfate-free shampoo significantly extends how long it lasts.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout title={title} description={description} path="/" ogImage="/images/og-keratin.svg" schema={[businessSchema, faqSchema]}>
  <!-- Hero: above-the-fold H1 + intro + dual CTA (call / form) -->
  <header class="pt-10 md:pt-16 pb-6">
    <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-[1.05fr_.95fr] gap-9 md:gap-14 items-center">
      <div>
        <span class="eyebrow">Elmwood Park, IL</span>
        <h1 class="text-[38px] md:text-[58px] font-serif font-semibold text-brand-900 leading-[1.08] tracking-tight mt-4 mb-5">
          Keratin Treatment in Elmwood Park
        </h1>
        <p class="text-lg text-stone-700 leading-relaxed max-w-[34em]">
          Looking for a keratin treatment in Elmwood Park? You're in the right place. A professional keratin
          smoothing treatment tames frizz, cuts your styling time dramatically, and leaves your hair glossy and
          manageable for months — whether it's thick, curly, color-treated, or just worn down by Chicago humidity.
          Below you'll find everything worth knowing before you book: the types of keratin treatments available,
          what they cost, how long they last, and the formaldehyde-free options you should ask about.
        </p>
        <div class="flex flex-wrap gap-3.5 mt-7">
          <a
            href={`tel:${SITE.phone}`}
            class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-base rounded-full px-6 py-4 shadow-soft transition-colors"
          >
            📞 Call {SITE.phoneDisplay}
          </a>
          <a
            href="#quote"
            class="inline-flex items-center gap-2 border-[1.5px] border-brand-200 text-brand-900 font-semibold text-base rounded-full px-6 py-4 hover:border-brand-600 hover:text-brand-600 transition-colors"
          >
            Get a free quote →
          </a>
        </div>
      </div>

      <div class="relative aspect-[4/5] md:aspect-[4/5] rounded-[22px] overflow-hidden shadow-soft order-first md:order-none bg-brand-800">
        <Image
          src={heroPhoto}
          alt="Close-up of smooth, glossy, healthy hair after a keratin treatment"
          width={700}
          height={875}
          quality={50}
          format="webp"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 [background:linear-gradient(0deg,rgba(36,26,21,.35)_0%,transparent_40%)]"></div>
      </div>
    </div>
  </header>

  <!-- Quote form: kept high on the page (spec requires it above the fold alongside click-to-call) -->
  <section id="quote" class="max-w-6xl mx-auto px-4 py-4">
    <div class="grid md:grid-cols-[1fr_auto] gap-8 items-center bg-brand-100/60 border border-brand-200 rounded-[22px] p-6 md:p-8">
      <div>
        <h2 class="text-xl md:text-2xl font-serif font-semibold text-brand-900 mb-1.5">Prefer not to call right now?</h2>
        <p class="text-stone-600 text-[15px] max-w-md">Send us your info and we'll get back to you with a same-day quote — no obligation.</p>
      </div>
      <QuoteForm compact />
    </div>
  </section>

  <!-- Trust strip -->
  <section class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid md:grid-cols-3 gap-5">
      <div class="bg-white border border-brand-200 rounded-[18px] p-7">
        <div class="w-[38px] h-[38px] rounded-full border-[1.5px] border-brand-600 text-brand-600 font-serif font-semibold text-sm flex items-center justify-center mb-4">01</div>
        <h3 class="text-lg font-serif font-semibold text-brand-900 mb-1.5">Consultation First</h3>
        <p class="text-[15px] text-stone-600">Every appointment starts by assessing your hair type and goals — not a one-size-fits-all treatment.</p>
      </div>
      <div class="bg-white border border-brand-200 rounded-[18px] p-7">
        <div class="w-[38px] h-[38px] rounded-full border-[1.5px] border-brand-600 text-brand-600 font-serif font-semibold text-sm flex items-center justify-center mb-4">02</div>
        <h3 class="text-lg font-serif font-semibold text-brand-900 mb-1.5">Formaldehyde-Free Options</h3>
        <p class="text-[15px] text-stone-600">Ask for cysteine-based or nanoplasty treatments if formaldehyde is a concern for you.</p>
      </div>
      <div class="bg-white border border-brand-200 rounded-[18px] p-7">
        <div class="w-[38px] h-[38px] rounded-full border-[1.5px] border-brand-600 text-brand-600 font-serif font-semibold text-sm flex items-center justify-center mb-4">03</div>
        <h3 class="text-lg font-serif font-semibold text-brand-900 mb-1.5">Serving the Area</h3>
        <p class="text-[15px] text-stone-600">Elmwood Park, Chicago's Northwest Side, and nearby: River Grove, River Forest, Oak Park, Norridge &amp; Melrose Park.</p>
      </div>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 prose-section">
    <h2>What Is a Keratin Treatment?</h2>
    <p>
      A keratin treatment is a professional smoothing service that infuses your hair with keratin — the same
      protein hair is naturally made of. A stylist applies the solution, then seals it in with a flat iron. The
      result: frizz is smoothed, curls are loosened and relaxed (not necessarily straightened), shine is restored,
      and your hair becomes far easier to style. It's one of the most popular ways to make thick, coarse, curly, or
      humidity-prone hair behave — without a daily fight.
    </p>
    <p>
      Unlike a chemical relaxer, a keratin treatment doesn't permanently alter your hair's structure. It gradually
      washes out over several weeks to a few months, so your natural texture always returns. For the full picture —
      the chemistry behind it, what a salon appointment actually involves, and how it compares to other
      straightening options — see our
      <a href="/what-is-a-keratin-treatment/" class="text-brand-600 font-medium">complete guide to keratin treatments →</a>.
    </p>

    <h2>Types of Keratin Treatments Available in Elmwood Park</h2>
    <p>
      Different hair, different goals — there's more than one kind of treatment, and the right one depends on your
      hair type and how much time you want to invest.
    </p>
  </div>

  <div class="max-w-3xl mx-auto px-4 not-prose mb-10">
    <div class="grid sm:grid-cols-2 gap-5">
      <div class="bg-white border border-brand-200 rounded-[18px] p-6 hover:shadow-soft hover:-translate-y-0.5 transition">
        <h3 class="text-xl font-serif font-semibold text-brand-900 mb-1.5">Brazilian Blowout</h3>
        <p class="font-serif text-[15px] font-semibold text-brand-600 mb-2.5">No downtime — wash same day</p>
        <p class="text-[15px] text-stone-600 mb-2">
          Reduces frizz and adds shine while keeping some natural volume and movement. Great for smoother, more
          manageable hair without going fully straight.
        </p>
        <a href="/brazilian-blowout/" class="text-brand-600 font-medium text-sm">Learn more →</a>
      </div>
      <div class="bg-white border border-brand-200 rounded-[18px] p-6 hover:shadow-soft hover:-translate-y-0.5 transition">
        <h3 class="text-xl font-serif font-semibold text-brand-900 mb-1.5">Traditional Keratin Smoothing</h3>
        <p class="font-serif text-[15px] font-semibold text-brand-600 mb-2.5">2–3 day no-wash period</p>
        <p class="text-[15px] text-stone-600">
          The longest-lasting option, with the most dramatic frizz reduction. Best for very thick, coarse, or
          unruly hair that wants maximum results.
        </p>
      </div>
      <div class="bg-white border border-brand-200 rounded-[18px] p-6 hover:shadow-soft hover:-translate-y-0.5 transition">
        <h3 class="text-xl font-serif font-semibold text-brand-900 mb-1.5">Express Keratin</h3>
        <p class="font-serif text-[15px] font-semibold text-brand-600 mb-2.5">Faster appointment</p>
        <p class="text-[15px] text-stone-600">
          A shorter, lower-cost treatment for milder frizz, or as a "maintenance" service between full treatments.
          Results last a few weeks.
        </p>
      </div>
      <div class="bg-white border border-brand-200 rounded-[18px] p-6 hover:shadow-soft hover:-translate-y-0.5 transition">
        <h3 class="text-xl font-serif font-semibold text-brand-900 mb-1.5">Formaldehyde-Free &amp; Cysteine</h3>
        <p class="font-serif text-[15px] font-semibold text-brand-600 mb-2.5">Gentler chemistry</p>
        <p class="text-[15px] text-stone-600 mb-2">
          Plant- or amino-acid derived formulas. Results are a little more subtle and don't last quite as long, but
          many clients prefer the peace of mind.
        </p>
        <a href="/cysteine-treatment/" class="text-brand-600 font-medium text-sm">More on cysteine →</a>
      </div>
      <div class="bg-white border border-brand-200 rounded-[18px] p-6 hover:shadow-soft hover:-translate-y-0.5 transition sm:col-span-2">
        <h3 class="text-xl font-serif font-semibold text-brand-900 mb-1.5">Nanoplasty</h3>
        <p class="font-serif text-[15px] font-semibold text-brand-600 mb-2.5">Formaldehyde-free · lasts 3–6 months</p>
        <p class="text-[15px] text-stone-600 mb-2">
          Nano-sized amino acids and proteins smooth deeper and last longer than a standard keratin treatment,
          without formaldehyde. We match clients with nanoplasty specialists in Elmwood Park and across Chicago's
          Northwest Side.
        </p>
        <a href="/nanoplasty/" class="text-brand-600 font-medium text-sm">Nanoplasty in Chicago: pricing &amp; booking →</a>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 not-prose mb-6">
    <!--
      These are stock/illustrative photos, not a documented single client's
      before-and-after — captions below are worded accordingly. If you swap
      in a real client transformation photo, get their written permission
      first and update the captions to reflect that it's a real result.
    -->
    <div class="grid grid-cols-2 gap-3">
      <div>
        <img
          src="/images/keratin-before.jpg"
          alt="Stylist blow-drying and prepping hair with a round brush"
          width="900"
          height="1200"
          loading="lazy"
          class="w-full h-auto rounded-2xl shadow bg-brand-100 object-cover aspect-[3/4]"
        />
        <p class="text-center text-xs text-stone-500 mt-1.5">Prep &amp; styling</p>
      </div>
      <div>
        <img
          src="/images/keratin-after.jpg"
          alt="Smooth, glossy finished hair after a salon blowout"
          width="900"
          height="1200"
          loading="lazy"
          class="w-full h-auto rounded-2xl shadow bg-brand-100 object-cover aspect-[3/4]"
        />
        <p class="text-center text-xs text-stone-500 mt-1.5">Smooth, glossy finish</p>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 prose-section">
    <h2>How Much Does a Keratin Treatment Cost in Elmwood Park?</h2>
    <p>
      Pricing depends on your hair length and thickness and the type of treatment. As a general guide in the
      Elmwood Park area:
    </p>
  </div>

  <div class="max-w-3xl mx-auto px-4 not-prose mb-6">
    <div class="overflow-x-auto rounded-[18px] border border-brand-200 bg-white">
      <table class="w-full text-left border-collapse text-[15.5px]">
        <thead>
          <tr class="bg-brand-100">
            <th class="px-5 py-4 text-[12.5px] font-semibold uppercase tracking-wide text-stone-600">Treatment</th>
            <th class="px-5 py-4 text-[12.5px] font-semibold uppercase tracking-wide text-stone-600">Typical Price</th>
          </tr>
        </thead>
        <tbody>
          {SITE.prices.map((p) => (
            <tr class="border-t border-brand-200">
              <td class="px-5 py-4">{p.name}</td>
              <td class="px-5 py-4 font-serif font-semibold text-brand-900">{p.range}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <!--
      BUILDER NOTE: replace the ranges above with the ACTUAL prices from your
      partner salon. Do not invent exact figures — mismatched pricing kills
      trust on the first call. Keep it as "starting at" ranges until confirmed.
    -->
  </div>

  <div class="max-w-3xl mx-auto px-4 prose-section">
    <p>
      Request a quote for an exact price based on your hair, or see the full
      <a href="/keratin-treatment-cost/" class="text-brand-600 font-medium">cost breakdown →</a>
    </p>

    <h2>How Long Does a Keratin Treatment Last?</h2>
    <p>
      Most keratin treatments last <strong>2 to 5 months</strong>, depending on the type and how you care for your
      hair afterward. Traditional keratin lasts longest; express and formaldehyde-free options are on the shorter
      end. The single biggest factor in longevity is your aftercare — a <strong>sulfate-free shampoo</strong>
      dramatically extends the life of any keratin treatment, while sulfates strip it out faster. For the full
      month-by-month breakdown, see
      <a href="/how-long-does-keratin-last/" class="text-brand-600 font-medium">How Long Does Keratin Last? →</a>
    </p>

    <h2>Is a Keratin Treatment Safe?</h2>
    <p>
      This is the most common question, and it's a fair one. The safety concern comes down to
      <strong>formaldehyde</strong>: some traditional smoothing solutions release formaldehyde gas when heated with
      a flat iron, which is why proper ventilation and a trained stylist matter. If formaldehyde is a concern for
      you, ask specifically for a <strong>formaldehyde-free treatment</strong> — cysteine-based and nanoplasty
      options are designed exactly for this. A licensed, experienced stylist will walk you through your options and
      help you choose the right formulation for your hair and comfort level. Full safety details:
      <a href="/is-keratin-safe/" class="text-brand-600 font-medium">Is Keratin Safe? →</a>
    </p>

    <!--
      public/images/brazilian-blowout-photo.jpg — this is a general hair
      lifestyle photo, not a documented treatment result, so the alt text
      below describes it honestly rather than implying it's a before/after.
      Swap for a properly-licensed Brazilian blowout result photo
      (Unsplash/Pexels, or a real client photo with permission) if you want
      this slot to show an actual treatment outcome.
    -->
    <img
      src="/images/brazilian-blowout-photo.jpg"
      alt="Hair in motion, showing natural volume and texture"
      width="1200"
      height="800"
      loading="lazy"
      class="w-full h-auto rounded-2xl shadow mt-2 mb-6 bg-brand-100 object-cover"
    />

    <h2>Keratin Treatment vs. Brazilian Blowout — What's the Difference?</h2>
    <p>
      They're often confused. The short version: a <strong>Brazilian blowout</strong> has no downtime (wash same
      day) and keeps more natural volume, while a <strong>traditional keratin treatment</strong> lasts longer and
      smooths more aggressively but needs a no-wash waiting period. If you want the full breakdown, see our guide:
      <a href="/keratin-vs-brazilian-blowout/" class="text-brand-600 font-medium">Keratin vs Brazilian Blowout →</a>
    </p>

    <h2>Hair Botox vs. Keratin — Which Do You Need?</h2>
    <p>
      "Hair botox" contains no actual Botox — it's a deep conditioning treatment that fills and repairs damaged
      strands, adding smoothness and softness. Keratin, by contrast, is primarily a <em>smoothing and frizz-control</em>
      treatment. If your main issue is frizz and styling time, keratin is usually the answer; if it's damage and
      dryness, hair botox may suit you better. Full comparison here:
      <a href="/hair-botox-vs-keratin/" class="text-brand-600 font-medium">Hair Botox vs Keratin →</a>
    </p>

    <h2>Will Keratin Help Thinning or Damaged Hair?</h2>
    <p>
      Keratin treatments don't regrow hair or treat hair loss — but by smoothing the cuticle and reducing the daily
      heat-styling and brushing that cause breakage, they can make thinning or fragile hair look noticeably
      healthier, fuller, and shinier. If your hair is damaged, a stylist can advise whether a gentler
      formaldehyde-free option or a repair-focused treatment is the better starting point.
    </p>
  </div>

  <!-- Booking CTA -->
  <section class="bg-brand-800 text-white mt-16">
    <div class="max-w-4xl mx-auto px-4 py-14 text-center">
      <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-3">Book Your Keratin Treatment in Elmwood Park</h2>
      <p class="text-brand-100 mb-6 max-w-xl mx-auto">
        Ready for smooth, frizz-free hair that lasts? Request a free quote and we'll match you with an experienced
        Elmwood Park keratin specialist. Same-day responses.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`tel:${SITE.phone}`}
          class="inline-flex items-center justify-center gap-2 bg-white text-brand-800 font-semibold rounded-full px-6 py-3.5 hover:bg-brand-50 transition-colors"
        >
          Call {SITE.phoneDisplay}
        </a>
        <a
          href="#quote"
          class="inline-flex items-center justify-center gap-2 border-2 border-white text-white font-semibold rounded-full px-6 py-3.5 hover:bg-white/10 transition-colors"
        >
          Fill Out the Quick Form
        </a>
      </div>
    </div>
  </section>

  <!-- Reviews -->
  <section class="max-w-3xl mx-auto px-4 py-14">
    <h2 class="text-2xl md:text-3xl font-serif font-semibold text-brand-900 mb-4">What Our Clients Say</h2>
    <!--
      BUILDER NOTE — IMPORTANT: do NOT fabricate reviews. Pull real reviews
      (with permission) from the partner salon's actual Google/Yelp profile
      once secured. Fake reviews violate FTC rules and Google's policies and
      can get the site penalized. This section intentionally ships without
      placeholder quotes — replace the callout below with real testimonials.
    -->
    <div class="rounded-[18px] border border-dashed border-brand-400 bg-brand-100 p-8 flex gap-4 items-start">
      <span class="text-2xl leading-none">★</span>
      <div>
        <h3 class="font-serif text-lg font-semibold text-brand-900 mb-1">Reviews coming soon</h3>
        <p class="text-stone-600 text-[15px]">
          Real client reviews are on the way. In the meantime, request a free quote and experience it for yourself.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 pb-16" id="faq">
    <h2 class="text-2xl md:text-3xl font-serif font-semibold text-brand-900 mb-2">Frequently Asked Questions</h2>
    <div>
      {faqs.map((f) => (
        <details class="group border-b border-brand-200">
          <summary class="cursor-pointer py-5 font-serif text-lg font-medium text-brand-900 flex items-center justify-between gap-4">
            {f.q}
            <span class="text-brand-600 text-2xl leading-none group-open:rotate-45 transition-transform shrink-0">+</span>
          </summary>
          <p class="text-stone-600 text-[15.5px] leading-relaxed pb-6 max-w-[64ch]">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>
