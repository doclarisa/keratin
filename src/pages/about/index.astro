---
import Layout from "../../layouts/Layout.astro";
import { SITE } from "../../config";

const title = `About ${SITE.businessName} | Keratin Treatment Referrals in Elmwood Park, IL`;
const description =
  "How Keratin Treatment Elmwood Park works — we connect you with local, experienced keratin specialists and help you get an honest quote.";
---

<Layout title={title} description={description} path="/about/">
  <div class="max-w-3xl mx-auto px-4 py-10 prose-section">
    <p class="text-sm text-brand-600 font-medium mb-2">
      <a href="/" class="hover:underline">Keratin Treatment Elmwood Park</a> / About
    </p>
    <h1 class="text-3xl md:text-4xl font-serif font-bold text-brand-900 mb-5">
      About {SITE.businessName}
    </h1>

    <h2>What We Do</h2>
    <p>
      {SITE.businessName} is a local guide and referral service for keratin treatments in Elmwood Park, IL. We're
      not a single salon — we connect you with experienced local keratin specialists, help you understand your
      options (traditional keratin, Brazilian blowout, cysteine, nanoplasty), and make sure you get a clear, honest
      quote before you book anything.
    </p>

    <h2>Why We Built This Guide</h2>
    <p>
      Keratin smoothing covers a lot of ground — formaldehyde vs. formaldehyde-free formulas, wildly different price
      ranges, and treatments that suit some hair types far better than others. Most sites selling a single service
      don't explain the trade-offs. Our goal is to lay out what each treatment actually does, what it costs, and how
      long it lasts, so you can ask the right questions before you sit in a stylist's chair. See the full
      <a href="/" class="text-brand-600 font-medium">keratin treatment overview →</a> for details on each option.
    </p>

    <h2>How a Request Works</h2>
    <p>
      Call or fill out the quote form and tell us a bit about your hair and what you're hoping to fix — frizz,
      curl, color-treated hair, humidity. We'll follow up with a same-day quote and connect you with a specialist
      serving Elmwood Park and the surrounding area, including River Grove, River Forest, Forest Park, Oak Park,
      Berwyn, and Melrose Park.
    </p>

    <p>
      Questions before you book? <a href={`tel:${SITE.phone}`} class="text-brand-600 font-medium">Call {SITE.phoneDisplay}</a>
      or <a href="/contact/" class="text-brand-600 font-medium">get in touch →</a>.
    </p>
  </div>
</Layout>
