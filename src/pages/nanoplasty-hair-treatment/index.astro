            <th class="px-5 py-3 text-[12.5px] font-semibold uppercase tracking-wide text-stone-600">Formaldehyde?</th>
            <th class="px-5 py-3 text-[12.5px] font-semibold uppercase tracking-wide text-stone-600">Lasts</th>
            <th class="px-5 py-3 text-[12.5px] font-semibold uppercase tracking-wide text-stone-600">Best For</th>
          </tr>
        </thead>
        <tbody class="text-stone-700">
          <tr class="border-t border-brand-200"><td class="px-5 py-3 font-medium">Nanoplasty</td><td class="px-5 py-3">Deep smoothing + straightening</td><td class="px-5 py-3">Marketed free (verify)</td><td class="px-5 py-3">~3–6 months</td><td class="px-5 py-3">Frizz + strong smoothing, longer wear</td></tr>
          <tr class="border-t border-brand-200"><td class="px-5 py-3 font-medium">Keratin treatment</td><td class="px-5 py-3">Smooths, seals cuticle</td><td class="px-5 py-3">Classic uses it; free versions exist</td><td class="px-5 py-3">3–5 months</td><td class="px-5 py-3">Frizz control, coarse/curly hair</td></tr>
          <tr class="border-t border-brand-200"><td class="px-5 py-3 font-medium">Cysteine treatment</td><td class="px-5 py-3">Gentle smoothing</td><td class="px-5 py-3">Free</td><td class="px-5 py-3">6 wks–3 months</td><td class="px-5 py-3">Mild frizz, natural result</td></tr>
          <tr class="border-t border-brand-200"><td class="px-5 py-3 font-medium">Hair botox</td><td class="px-5 py-3">Deep conditioning/repair</td><td class="px-5 py-3">Free</td><td class="px-5 py-3">2–4 months</td><td class="px-5 py-3">Damage, softness (not straightening)</td></tr>
          <tr class="border-t border-brand-200"><td class="px-5 py-3 font-medium">Relaxer</td><td class="px-5 py-3">Permanent straightening</td><td class="px-5 py-3">No (alkaline chemistry)</td><td class="px-5 py-3">Permanent (regrowth reverts)</td><td class="px-5 py-3">Very coarse/coily hair</td></tr>
        </tbody>
      </table>
    </div>
